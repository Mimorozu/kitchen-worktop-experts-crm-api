generator client {
  provider = "prisma-client-js"
}

// points to database
datasource db {
  provider = "postgresql"
}


model Lead {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Customer contact info
  name         String
  email        String
  phone        String
  addressLine1 String?
  addressLine2 String?
  postcode     String

  // Job details
  size            String?    // "Small", "Medium", "Large"
  material        String?   // "Quartz", "Granite", "Porcelain"
  quartzStyle     String?
  kitchenColour   String?
  kitchenStyle    String?
  floorColour     String?
  handleColour    String?
  wallColour      String?
  specialFeatures String?
  selectedMaterial String?
  budget          String?
  timeline        String?
  photoUrl        String?

  // Dates
  templateDate        DateTime?
  installDate          DateTime?
  kitchenInstallDate  DateTime?
  warehouseVisitDate  DateTime?
  followUpDate        DateTime?

  // CRM fields (you fill these in)
  status      String   @default("New")
  source      String?
  notes       String?
  quoteValue  Float?

  // Staff member who created the lead; null for website leads. Any signed-in staff can view and edit every lead.
  userId      Int?
  user        User?    @relation(fields: [userId], references: [id])

  photos      Photo[]
  activityLog ActivityLog[]
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  type      String   @default("note")
  message   String

  leadId    Int
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model Photo {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now())
  filename     String
  url          String
  publicId     String   // Cloudinary public_id, needed to delete the asset later
  resourceType String   // Cloudinary resource_type ("image" or "raw") — destroy() needs the resolved type, not "auto"
  delivery     String   @default("upload") // "upload" = legacy public URL; "authenticated" = private, signed URLs only
  format       String?  // file type detected from the contents ("jpg", "png", "webp", "pdf")

  leadId     Int
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  leads     Lead[]

  // Auth hardening
  emailVerified   Boolean   @default(false)
  verifyTokenHash String?
  verifyExpiresAt DateTime?
  resetTokenHash  String?
  resetExpiresAt  DateTime?
  failedLogins    Int       @default(0)
  lockedUntil     DateTime?
  tokenVersion    Int       @default(0) // bumped on password reset; older JWTs stop working
}

// Single-row table: id is always 1. Holds the quote pricing settings as JSON.
model Pricing {
  id        Int      @id @default(1)
  data      Json
  updatedAt DateTime @updatedAt
}