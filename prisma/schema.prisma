generator client {
  provider = "prisma-client-js"
}

// points to database
datasource db {
  provider = "postgresql"
}


model Lead {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Customer contact info
  name         String
  email        String
  phone        String
  addressLine1 String?
  addressLine2 String?
  postcode     String

  // Job details
  size            String?    // "Small", "Medium", "Large"
  material        String?   // "Quartz", "Granite", "Porcelain"
  quartzStyle     String?
  kitchenColour   String?
  kitchenStyle    String?
  floorColour     String?
  handleColour    String?
  wallColour      String?
  specialFeatures String?
  selectedMaterial String?
  budget          String?
  timeline        String?
  photoUrl        String?

  // Dates
  templateDate        DateTime?
  installDate          DateTime?
  kitchenInstallDate  DateTime?
  warehouseVisitDate  DateTime?
  followUpDate        DateTime?

  // CRM fields (you fill these in)
  status      String   @default("New")
  source      String?
  notes       String?
  quoteValue  Float?

  // Which user (staff member) owns this lead
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  leads     Lead[]
}